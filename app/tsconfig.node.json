{
  // TypeScript de lo que corre en Node: pruebas (Vitest y Playwright) y archivos de configuración.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // vite/client: las pruebas importan código de src/ que usa import.meta.env.BASE_URL (Vitest lo define).
    "types": ["node", "vite/client"],
    // Los scripts .mjs de scripts/ también se revisan: sus tipos van en comentarios JSDoc (@param, @returns…).
    "allowJs": true,
    "checkJs": true,
    // Las pruebas leen posiciones que ya conocen (ej. filas[0] de un Excel armado en la prueba):
    // aquí no se exige revisar si existen (la app, en tsconfig.json, sí lo exige).
    "noUncheckedIndexedAccess": false
  },
  "include": ["tests", "scripts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
