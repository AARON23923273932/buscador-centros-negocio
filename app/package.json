{
  "name": "buscador-centros-negocio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Buscador de centros de negocio y órdenes de compra/servicio (AIC)",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts playwright.config.ts",
    "build": "npm run typecheck && npm run lint && vite build",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generar-ejemplo": "node scripts/generar-ejemplo.mjs",
    "preparar-publicacion": "node scripts/preparar-publicacion.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
